<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Добавление раствора</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="app">
  <div class="screen add-screen">
    <form class="add-card" method="GET" action="/draft">
      <h1 class="title">Добавление растворов</h1>

      <label class="field-label" for="substanceName">Название вещества</label>
      <input class="field-input" id="substanceName" name="substanceName" type="text" value="{{draft.substanceName}}">

      <label class="field-label" for="chemicalFormula">Химическая формула</label>
      <input class="field-input" id="chemicalFormula" name="chemicalFormula" type="text" value="{{draft.chemicalFormula}}">

      <label class="field-label" for="electrolyteType">Тип электролита</label>
      <input class="field-input" id="electrolyteType" name="electrolyteType" type="text" value="{{draft.electrolyteType}}">

      <label class="field-label" for="molarConcentration">Молярная концентрация, моль/л</label>
      <input class="field-input" id="molarConcentration" name="molarConcentration" type="number" step="0.01" value="{{draft.molarConcentration}}">

      <label class="field-label" for="description">Текстовое описание</label>
      <input class="field-input" id="description" name="description" type="text" value="{{draft.description}}">

      <label class="field-label" for="volumeMl">Объём раствора, мл</label>
      <input class="field-input" id="volumeMl" name="volumeMl" type="number" value="{{draft.volumeMl}}">

      <p class="field-label">Медиа</p>
      <div class="media-buttons">
        <!-- Выбор файла на чистом HTML (label + input type=file). Сам файл
             не сохраняется — загрузка в MinIO это задача ЛР2. -->
        <label class="media-btn">
          <input type="file" name="photo" accept="image/*" hidden>
          + Фото
        </label>
        <label class="media-btn">
          <input type="file" name="video" accept="video/*" hidden>
          + Видео
        </label>
      </div>

      <!-- Сохранение (POST) — задача ЛР2. В ЛР1 кнопка задизейблена намеренно. -->
      <button type="submit" class="submit-btn" disabled>Добавить раствор</button>
    </form>

    {{> navbar}}
  </div>
</body>
</html>
