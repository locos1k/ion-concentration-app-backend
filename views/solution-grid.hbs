<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Каталог растворов</title>
  <link rel="stylesheet" href="/css/solutions.css">
</head>
<body class="app">
  <div class="screen grid-screen">
    <h1 class="title">Каталог растворов</h1>

    <form class="filter-form" method="GET" action="/solutions/list">
      <label class="field-label">Молярная концентрация, моль/л: от {{filterMin}} до {{filterMax}}</label>
      <div class="range-slider">
        <div class="range-slider__track"></div>
        <input type="range" name="min" min="{{filterBoundMin}}" max="{{filterBoundMax}}" step="{{filterStep}}" value="{{filterMin}}">
        <input type="range" name="max" min="{{filterBoundMin}}" max="{{filterBoundMax}}" step="{{filterStep}}" value="{{filterMax}}">
      </div>
      <button type="submit" class="filter-btn">Найти</button>
    </form>

    <div class="cards-grid">
      {{#each solutions}}
        {{> solution-card this}}
      {{else}}
        <p class="empty">Ничего не найдено</p>
      {{/each}}
    </div>

    {{> solutions-navbar}}
  </div>
</body>
</html>
