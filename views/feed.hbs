<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{#if solution}}{{solution.substanceName}}{{else}}Лента{{/if}}</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="app">
  <div class="screen feed-screen">
    {{#if solution}}
    <div class="media-wrap">
      <!-- poster не задаём намеренно: он моргал перед стартом видео.
           videoUrl всегда заполнен — при пустом поле в БД сервис подставляет
           дефолтное видео с SSR-сервера. -->
      <video class="media" autoplay muted loop playsinline preload="auto">
        <source src="{{solution.videoUrl}}">
      </video>

      <!-- Справа сверху вниз: лайк, «следующий», затем иконки-показатели pH и молярной концентрации -->
      <div class="side-actions">
        <div class="like-btn">
          <img class="like-icon" src="/img/like-icon.png" alt="Лайки">
          <span>{{solution.likesCount}}</span>
        </div>

        <a class="next-btn" href="/solutions/{{solution.id}}?next=true" aria-label="Следующий">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" style="transform: rotate(90deg); display: inline-block;">
            <path d="M9 6l6 6-6 6" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>

        <div class="field-badge" aria-label="pH">
          <span class="field-badge__label">pH</span>
          <span class="field-badge__value">{{solution.ph}}</span>
        </div>

        <div class="field-badge" aria-label="Молярная концентрация">
          <span class="field-badge__label">моль/л</span>
          <span class="field-badge__value">{{solution.molarConcentration}}</span>
        </div>
      </div>

      <div class="info-overlay">
        <div class="info-text">
          <h1 class="title">{{solution.substanceName}}</h1>

          <!-- «Ещё» без JS: нативный <details>, видно ровно 2 строки до раскрытия -->
          <div class="description">{{solution.descriptionShort}}{{#if solution.descriptionRest}}<details class="desc-more"><summary></summary>{{solution.descriptionRest}}</details>{{/if}}</div>
        </div>
      </div>
    </div>
    {{else}}
      <p class="empty">Опубликованных растворов пока нет</p>
    {{/if}}

    {{> navbar}}
  </div>
</body>
</html>
