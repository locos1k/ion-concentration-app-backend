<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Добавление раствора</title>
  <link rel="stylesheet" href="/css/solutions.css">
</head>
<body class="app">
  <div class="screen add-screen">
    {{#if draft}}
    <form class="add-card" method="POST" action="/solutions/draft/publish">
      <h1 class="title">Добавление растворов</h1>

      <p class="field-label">Медиа</p>
      <div class="media-buttons">
        <label class="media-btn">
          <input type="file" name="photo" accept="image/*" hidden>
          <span>+ Фото</span>
          <img class="media-thumb" src="{{draft.imageUrl}}" alt="Фото раствора «{{draft.substanceName}}»">
        </label>
        <label class="media-btn">
          <input type="file" name="video" accept="video/*" hidden>
          <span>+ Видео</span>
          <video class="media-thumb" src="{{draft.videoUrl}}" poster="{{draft.imageUrl}}" autoplay muted loop playsinline></video>
        </label>
      </div>

      <label class="field-label" for="substanceName">Название вещества</label>
      <input class="field-input" id="substanceName" type="text" value="{{draft.substanceName}}" disabled>

      <label class="field-label" for="molarConcentration">Молярная концентрация, моль/л</label>
      <input class="field-input" id="molarConcentration" name="molarConcentration" type="number" step="0.01" value="{{draft.molarConcentration}}">

      <label class="field-label" for="ph">pH</label>
      <input class="field-input" id="ph" name="ph" type="number" step="0.1" min="0" max="14" value="{{draft.ph}}">

      <label class="field-label" for="description">Текстовое описание</label>
      <input class="field-input" id="description" name="description" type="text" value="{{draft.description}}">

      <button type="submit" class="submit-btn">Опубликовать</button>
    </form>
    {{else}}
    <form class="add-card" method="POST" action="/solutions/draft">
      <h1 class="title">Добавление растворов</h1>

      <p class="field-label">Медиа</p>
      <div class="media-buttons">
        <label class="media-btn">
          <input type="file" name="photo" accept="image/*" hidden>
          <span>+ Фото</span>
          <img class="media-thumb" src="{{defaultImageUrl}}" alt="Фото по умолчанию">
        </label>
        <label class="media-btn">
          <input type="file" name="video" accept="video/*" hidden>
          <span>+ Видео</span>
          <video class="media-thumb" src="{{defaultVideoUrl}}" poster="{{defaultImageUrl}}" autoplay muted loop playsinline></video>
        </label>
      </div>

      <label class="field-label" for="substanceName">Название вещества</label>
      <input class="field-input" id="substanceName" name="substanceName" type="text" required>

      <button type="submit" class="submit-btn">Далее</button>
    </form>
    {{/if}}

    {{> solutions-navbar}}
  </div>
</body>
</html>
